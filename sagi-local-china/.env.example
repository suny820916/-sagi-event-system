SAGI_SECRET=change-this-to-a-long-random-secret
SAGI_DATA_DIR=/data

# Optional OpenAI-compatible AI gateway reachable in China
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
AI_TIMEOUT_SECONDS=35
MAX_UPLOAD_MB=12
PUBLIC_BASE_URL=

# 管理后台密钥（必须修改）
SAGI_ADMIN_KEY=change-this-admin-key

# 存储：local 或 s3
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 正式域名，例如 local.sagisports.cn
PUBLIC_DOMAIN=
PUBLIC_BASE_URL=

# 备份
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
