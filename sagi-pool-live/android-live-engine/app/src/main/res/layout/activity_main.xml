<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050706">

    <com.tencent.rtmp.ui.TXCloudVideoView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="#E6080A09"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/player1"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="球员A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/score"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="#F2F4F1"
            android:gravity="center"
            android:text="0 : 0"
            android:textColor="#090B0A"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/player2"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:text="球员B"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/directorModeButton"
        android:layout_width="112dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:text="隐藏控制"
        android:textSize="11sp"/>

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="#E6101412"
        android:orientation="vertical"
        android:padding="11dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE ENGINE · V0.5"
            android:textColor="#DCE4DE"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/networkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="网络：未推流"
            android:textColor="#8FA198"
            android:textSize="11sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="54dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="画质"
                android:textColor="#AAB6AF"
                android:textSize="11sp"/>

            <Spinner
                android:id="@+id/qualitySpinner"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/audioButton"
                android:layout_width="112dp"
                android:layout_height="42dp"
                android:text="麦克风 开"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/installCode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="8位安装码"
                android:inputType="textCapCharacters"
                android:maxLength="12"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#718078"/>

            <Button
                android:id="@+id/claimInstallButton"
                android:layout_width="120dp"
                android:layout_height="42dp"
                android:text="领取配置"
                android:textSize="11sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/syncUrl"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="国内同步服务器 HTTPS"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#718078"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/clubId"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="Club ID"
                android:singleLine="true"
                android:text="SAGI-DEMO"
                android:textColor="#FFFFFF"
                android:textColorHint="#718078"/>

            <EditText
                android:id="@+id/tableNo"
                android:layout_width="100dp"
                android:layout_height="42dp"
                android:hint="球桌"
                android:singleLine="true"
                android:text="01桌"
                android:textColor="#FFFFFF"
                android:textColorHint="#718078"/>
        </LinearLayout>

        <EditText
            android:id="@+id/syncToken"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="球房同步密钥"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#718078"/>

        <EditText
            android:id="@+id/rtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="rtmp:// 推流地址"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#718078"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/switchCameraButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="切镜头"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/torchButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="灯光"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/zoomOutButton"
                android:layout_width="58dp"
                android:layout_height="42dp"
                android:text="−"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="54dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/zoomInButton"
                android:layout_width="58dp"
                android:layout_height="42dp"
                android:text="+"
                android:textSize="16sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/healthButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="开播检测"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="开始直播"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="停止"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
