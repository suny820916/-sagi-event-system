 if($name -eq 'output-latest.html'){
  $timerScript=@'
(()=>{
 const timers=new Set(),intervals=new Set();
 const syncTimeout=window.setTimeout.bind(window),syncInterval=window.setInterval.bind(window);
 const syncClearTimeout=window.clearTimeout.bind(window),syncClearInterval=window.clearInterval.bind(window);
 window.setTimeout=(fn,delay,...args)=>{
  if(typeof fn!=='function')return syncTimeout(fn,delay,...args);
  const id=syncTimeout((...values)=>{timers.delete(id);fn(...values)},delay,...args);
  timers.add(id);return id;
 };
 window.setInterval=(fn,delay,...args)=>{const id=syncInterval(fn,delay,...args);intervals.add(id);return id};
 window.clearTimeout=id=>{timers.delete(id);intervals.delete(id);return syncClearTimeout(id)};
 window.clearInterval=id=>{intervals.delete(id);timers.delete(id);return syncClearInterval(id)};
