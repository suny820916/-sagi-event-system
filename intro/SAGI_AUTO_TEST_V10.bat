 function Read-Heartbeat([string]$client){
  $file=Join-Path $root ($client+'.json')
  if(!(Test-Path -LiteralPath $file)){return}
  $stream=[IO.File]::Open($file,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::ReadWrite)
