function GetRaw($path){(Invoke-WebRequest -UseBasicParsing -Uri ($base+$path) -TimeoutSec 2).Content}
function Post($obj,$expected=200,$path='/api/matchday'){
 $identity=GetRaw '/health'|ConvertFrom-Json
 if($identity.sandboxToken -ne $env:SAGI_SANDBOX_TOKEN -or $identity.mode -ne 'SANDBOX'){throw 'Sandbox identity mismatch; write blocked'}
 $code=0
 try {$r=Invoke-WebRequest -UseBasicParsing -Uri ($base+$path) -Method Post -ContentType 'application/json' -Body ([Text.Encoding]::UTF8.GetBytes(($obj|ConvertTo-Json -Depth 30 -Compress))) -TimeoutSec 4;$code=[int]$r.StatusCode} catch {if($_.Exception.Response){$code=[int]$_.Exception.Response.StatusCode}else{throw}}
 if($code -ne $expected){throw "Expected HTTP $expected got $code"}
}
function Select-SandboxPort {
 do {
  $probe=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,0)
  try {$probe.Start();$script:port=$probe.LocalEndpoint.Port}finally{$probe.Stop()}
 }while($port -in @(8088,8100))
