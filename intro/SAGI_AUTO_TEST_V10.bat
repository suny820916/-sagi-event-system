<script>
window.addEventListener('load',()=>{const r=document.createElement('pre');r.id='sagi-test-result';document.body.appendChild(r);try{const h=[];for(let i=0;i<6;i++){h.push({side:'HOME',result:'GOAL'},{side:'AWAY',result:'GOAL'});}const g={fixtureKey:'browser-test',revision:1,home:'HOME',away:'AWAY',homeScore:1,awayScore:1,scoreboardVisible:true,clock:{period:'PEN',running:false,baseSeconds:0},penaltyShootout:{started:true,rounds:5,currentRound:7,suddenDeath:true,history:h,homeGoals:6,awayGoals:6,nextSide:'HOME'}};window.__sagiSandboxApplyGraphics(g);const count=(id,cls)=>document.querySelectorAll('#'+id+' '+cls).length;const board=document.getElementById('simplePenaltyBoard');const visible=board.classList.contains('on')&&getComputedStyle(board).display!=='none'&&board.getBoundingClientRect().width>0;const six=visible&&count('spbHomeDots','.spbDot.on')===6&&count('spbAwayDots','.spbDot.on')===6&&board.classList.contains('sudden');g.revision=2;g.penaltyShootout.history=h.slice(0,11);g.penaltyShootout.awayGoals=5;window.__sagiSandboxApplyGraphics(g);const undo=count('spbAwayDots','.spbDot.on')===5;g.revision=3;g.clock.period='2H';g.penaltyShootout.started=false;window.__sagiSandboxApplyGraphics(g);const hide=!board.classList.contains('on');const score=()=>[document.getElementById('sbHomeScore').textContent,document.getElementById('sbAwayScore').textContent].join(':');const regular=hide&&document.getElementById('scoreBug').classList.contains('on')&&score()==='1:1';const next={...g,revision:4,homeScore:2};window.__sagiSandboxApplyGraphics(next);const update=score()==='2:1';const rejected=window.__sagiSandboxApplyGraphics({...next,revision:3,homeScore:9})===false&&score()==='2:1';window.__sagiSandboxApplyGraphics({...next,fixtureKey:'browser-test-next',revision:1,homeScore:0,awayScore:0});const fixture=score()==='0:0';r.textContent=(six&&undo&&hide&&regular&&update&&rejected&&fixture?'SAGI_RENDER_PASS':'SAGI_RENDER_FAIL')+' six='+six+' undo='+undo+' hide='+hide+' regular='+regular+' scoreUpdate='+update+' staleRejected='+rejected+' fixtureSwitch='+fixture;}catch(e){r.textContent='SAGI_RENDER_FAIL '+e.message;}});
