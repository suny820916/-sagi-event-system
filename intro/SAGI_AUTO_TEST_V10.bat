function Debug-Edge([string]$method,[hashtable]$params=@{},[string]$session=''){
 $script:messageId++
 $request=@{id=$script:messageId;method=$method;params=$params}
 if($session){$request.sessionId=$session}
 $bytes=[Text.Encoding]::UTF8.GetBytes(($request|ConvertTo-Json -Depth 15 -Compress))
 $cancel=[Threading.CancellationTokenSource]::new([TimeSpan]::FromSeconds(12))
 try{
  [void]$socket.SendAsync([ArraySegment[byte]]::new($bytes),[Net.WebSockets.WebSocketMessageType]::Text,$true,$cancel.Token).GetAwaiter().GetResult()
  $buffer=[byte[]]::new(65536)
  do{
   $message=[IO.MemoryStream]::new()
   try{
    do{
     $part=$socket.ReceiveAsync([ArraySegment[byte]]::new($buffer),$cancel.Token).GetAwaiter().GetResult()
     if($part.MessageType -eq [Net.WebSockets.WebSocketMessageType]::Close){throw 'Edge disconnected'}
     $message.Write($buffer,0,$part.Count)
    }while(!$part.EndOfMessage)
    $reply=[Text.Encoding]::UTF8.GetString($message.ToArray())|ConvertFrom-Json
   }finally{$message.Dispose()}
  }while($reply.id -ne $request.id)
  if($reply.error){throw "$method failed: $($reply.error.message)"}
  $reply.result
 }finally{$cancel.Dispose()}
}
function Evaluate-Edge([string]$session,[string]$expression){
 $reply=Debug-Edge 'Runtime.evaluate' @{expression=$expression;returnByValue=$true;awaitPromise=$true} $session
 if($reply.exceptionDetails){
  $detail=$reply.exceptionDetails.exception.description
  if(!$detail){$detail=$reply.exceptionDetails.text}
  throw $detail
 }
 $reply.result.value
}
function Wait-Test([string]$label,[scriptblock]$predicate,[int]$seconds=12){
 $deadline=[DateTime]::UtcNow.AddSeconds($seconds)
 $problem=''
 do{
  try{if(& $predicate){return}}catch{$problem=$_.Exception.Message}
  Start-Sleep -Milliseconds 120
 }while([DateTime]::UtcNow -lt $deadline)
 throw "$label timed out. $problem"
}
function New-BrowserClient([string]$path){
 $context=(Debug-Edge 'Target.createBrowserContext').browserContextId
 $target=(Debug-Edge 'Target.createTarget' @{url='about:blank';browserContextId=$context}).targetId
 $session=(Debug-Edge 'Target.attachToTarget' @{targetId=$target;flatten=$true}).sessionId
 [void](Debug-Edge 'Emulation.setDeviceMetricsOverride' @{width=1440;height=900;deviceScaleFactor=1;mobile=$false} $session)
 $navigation=Debug-Edge 'Page.navigate' @{url=$base+$path} $session
 if($navigation.errorText){throw "Client navigation failed for ${path}: $($navigation.errorText)"}
 $required=if($path -eq '/vmix'){'scoreBug'}else{'setupReadyBtn'}
 Wait-Test "client load $path" { (Evaluate-Edge $session "document.readyState!=='loading' && location.href.startsWith('$base/') && !!document.getElementById('$required')") -eq $true }
 $session
}
function Click-Operator([string]$name,[switch]$Pointer){
 if($Pointer){
  $point=Evaluate-Edge $control "(()=>{const e=document.getElementById('$name');if(!e||e.disabled)throw Error('$name is unavailable');e.scrollIntoView({block:'center',inline:'center'});const r=e.getBoundingClientRect(),x=r.left+r.width/2,y=r.top+r.height/2,hit=document.elementFromPoint(x,y);if(!r.width||!e.contains(hit))throw Error('$name is not visible or is blocked');return {x,y}})()"
  foreach($type in 'mousePressed','mouseReleased'){
   [void](Debug-Edge 'Input.dispatchMouseEvent' @{type=$type;x=$point.x;y=$point.y;button='left';clickCount=1} $control)
  }
 }else{
  $expr="(()=>{const button=document.getElementById('$name');if(!button||button.disabled||!button.onclick)throw Error('$name is unavailable');button.click();return true})()"
  if(!(Evaluate-Edge $control $expr)){throw "Button $name did not run"}
 }
}
function Save-Frame([string]$session,[string]$label){
 $frame=Debug-Edge 'Page.captureScreenshot' @{format='png';fromSurface=$true} $session
 $path=Join-Path $evidence ($label+'.png')
 [IO.File]::WriteAllBytes($path,[Convert]::FromBase64String($frame.data))
 if((Get-Item -LiteralPath $path).Length -lt 1000){throw "Empty screenshot: $label"}
}
function Score-Visible([string]$session,[int]$homeGoals,[int]$away){
 (Evaluate-Edge $session "document.getElementById('scoreBug')?.classList.contains('on') && document.getElementById('sbHomeScore').textContent==='$homeGoals' && document.getElementById('sbAwayScore').textContent==='$away'") -eq $true
}
