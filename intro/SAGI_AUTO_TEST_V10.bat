   if($timerCounts[$i].intervals -ne $initialTimers[$i].intervals -or $timerCounts[$i].timeouts -gt ($initialTimers[$i].timeouts+12)){throw 'Output timer budget exceeded'}
  }
  [void]$samples.Add(@{seconds=[Math]::Round($timer.Elapsed.TotalSeconds,2);browserPrivateBytes=$memory;outputs=@($a,$b)})
  $sampleCount++
  Start-Sleep -Seconds 2
 }while($timer.Elapsed.TotalSeconds -lt $soakSeconds)
