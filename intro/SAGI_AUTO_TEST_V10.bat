 do{
  $browser.Refresh()
  if($browser.HasExited){throw 'Browser exited during soak'}
  $memory=(Get-Process -Id $browser.Id).PrivateMemorySize64
  $v=MatchState
  if($v.revision -ne $lastRevision -or $v.fixtureKey -ne $fixture){throw "Unexpected live state during soak: $($v.revision) $($v.fixtureKey)"}
  $a=Read-Heartbeat 'sagi-soak-a'
  $b=Read-Heartbeat 'sagi-soak-b'
  if(!$a -or !$b){throw 'An independent output heartbeat disappeared'}
  $now=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
  foreach($client in @($a,$b)){
   if($now-$client.receivedAt -gt 6000 -or $client.stale -gt 5000 -or
