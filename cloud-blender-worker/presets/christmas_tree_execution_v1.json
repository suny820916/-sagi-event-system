  "execution_phases": [
    {
      "name": "BUILD",
      "from": 0,
      "to": 2.4,
      "question": "How is the first line connected to Pirlo?"
    },
    {
      "name": "STRETCH",
      "from": 2.4,
      "to": 4.3,
      "question": "How do the side midfielders open the central passing lane?"
    },
    {
      "name": "BETWEEN_LINES",
      "from": 4.3,
      "to": 6.6,
      "question": "How does Kaka receive between the lines and pull the block inward?"
    },
    {
      "name": "OVERLAP",
      "from": 6.6,
      "to": 9.2,
      "question": "How does the right back exploit the outside lane after central attraction?"
    },
    {
      "name": "SHIFT_AND_SWITCH",
      "from": 9.2,
      "to": 12.4,
      "question": "How does strong-side occupation move the whole defensive block before the switch?"
    },
    {
      "name": "COMPLETE",
      "from": 12.4,
      "to": 18,
      "question": "How is the weak-side space received, attacked and converted into a finish?"
    }
  ],
  "initial_ball_holder": "LCB",
  "require_defensive_reaction": true,
  "benchmark": {
    "reference": "TEACTICS",
    "principle": "learn_expression_not_copy_content",
    "locked_direction": true,
    "priorities": [
      "semi_global_should_not_default_to_near_full_pitch",
      "local_relation_shots_should_be_defined_by_relevant_players_only",
      "local_and_global_views_are_both_valid_when_tactically_justified",
      "field_extent_should_change_with_tactical_question",
      "visible_pitch_scope_must_match_tactical_information",
      "full_pitch_and_local_pitch_are_both_valid_when_tactically_motivated",
      "weak_side_space_must_be_caused_by_collective_defensive_shift",
      "defenders_should_move_as_a_block_not_as_isolated_markers",
      "receive_turn_next_action_must_read_as_one_chain",
      "body_orientation_should_reveal_tactical_intent",
      "no_floating_pitch_or_black_void_in_wide_structure_views",
      "no_abrupt_scale_reset_between_tactical_phases",
      "camera_center_must_follow_tactical_progression",
      "no_tactical_subject_on_frame_edge",
      "whole_tactical_picture_before_local_beauty",
      "local_relation_must_keep_formation_context",
      "spatial_continuity_between_phases",
      "relation_camera_must_protect_start_mid_end_positions",
      "switch_camera_may_follow_ball_between_zones",
      "players_must_read_as_people_not_chess_pieces",
      "tactical_clarity",
      "complete_execution",
      "stable_camera_until_relation_changes",
      "ball_drives_tempo",
      "player_reaction_follows_tactical_cause",
      "no_unnecessary_effects",
      "no_dramatic_climax",
      "minimal_dead_time",
      "few_relevant_players_per_frame"
    ]
  },
  "visual_integrity": {
    "locked": true,
    "rule": "Every tactical shot must preserve both the local relation and enough formation structure to understand where it belongs.",
    "minimum_context": "carrier + next option + nearest defender + two structural anchors",
    "no_isolated_triangle_shots": true,
    "no_contextless_closeups": true,
    "preserve_attack_direction": true,
    "preserve_spatial_continuity": true,
    "edge_safe_zone": true,
    "edge_safe_rule": "No tactical subject should sit on or be clipped by the portrait-frame edge.",
    "spatial_continuity": true,
    "scale_continuity": true,
    "continuous_tactical_background": true,
    "background_rule": "Wide tactical views may reveal more board, but must never reveal a hard visual void beyond the pitch.",
    "field_scope_is_tactical": true,
    "field_scope_rule": "The amount of pitch visible must be chosen by tactical information need, not by a fixed camera aesthetic."
  },
  "camera_continuity": {
    "preserve_forward_progression": true,
    "max_backward_target_m": 1.5,
    "lead_sec": 0.34,
    "settle_sec": 0.32,
    "principle": "preserve spatial continuity, but allow deliberate tactical scale changes between structure and relation shots",
    "preserve_scale_continuity": true,
    "max_zoom_in_per_phase_m": 8,
    "allow_scale_reset_on_shot_scale_change": true
  },
  "action_continuity": {
    "enabled": true,
    "principle": "the next tactical action begins in body orientation before the current action fully ends",
    "passer_pre_turn_sec": 0.12,
    "receiver_scan_sec": 0.18,
    "post_receive_turn_window_sec": 0.34,
    "first_touch_distance_m": 0.16
  },
  "defensive_response": {
    "enabled": true,
    "principle": "space must be created by visible collective defensive movement, not by static empty zones",
    "strong_side_shift": "right",
    "weak_side_release": "left"
  },
  "scale_script": {
    "principle": "CENTRAL_MASTER provides the spatial map; STRUCTURE and RELATION shots then use only the pitch extent needed to explain the current tactical question",
    "benchmark": "TEACTICS",
    "rules": [
      "use full or near-full pitch only when the viewer needs global structure",
      "use half-pitch or zone framing when the tactical relation is local",
      "never show the whole field just to look complete",
      "never crop pitch landmarks that are needed to understand the action",
      "return to wider pitch context after a local tactical explanation when the next phase depends on global spacing",
      "global-to-local and local-to-global scale changes may be decisive when the tactical question changes"
    ],
    "phases": {
      "BUILD": {
        "shot_scale": "STRUCTURE",
        "field_scope": "BUILD_RELATION_ZONE",
        "purpose": "show LCB-Pirlo-first pressure and enough midfield landmark context without shrinking players"
      },
      "STRETCH": {
        "shot_scale": "WIDE_STRUCTURE",
        "field_scope": "MIDFIELD_WIDTH_ZONE",
        "purpose": "show both side midfielders stretching the block while keeping the midfield relation readable on mobile"
      },
      "BETWEEN_LINES": {
        "shot_scale": "RELATION",
        "field_scope": "MIDFIELD_ZONE",
        "purpose": "show Pirlo-Kaka-defender relation without wasting screen on remote pitch"
      },
      "OVERLAP": {
        "shot_scale": "RELATION",
        "field_scope": "RIGHT_CHANNEL_ZONE",
        "purpose": "show Kaka-RB-defender triangle and overlap timing"
      },
      "SHIFT_AND_SWITCH": {
        "shot_scale": "CENTRAL_MASTER",
        "field_scope": "FLOATING_BOARD",
        "purpose": "return to the floating spatial map before the weak-side switch so the defensive block movement is visible"
      },
      "COMPLETE": {
        "shot_scale": "RESULT_RELATION",
        "field_scope": "FINAL_THIRD",
        "purpose": "show weak-side receive, central occupation, defenders and goal relation"
      },
      "OPENING_MASTER": {
        "shot_scale": "CENTRAL_MASTER",
        "field_scope": "FLOATING_BOARD",
        "purpose": "establish the floating pitch as the spatial map before any local explanation"
      }
    },
    "local_relation_history_sec": 0.56
  },
  "field_scale_script": {
    "enabled": true,
    "principle": "field visibility and camera scale are chosen by tactical information needs, not visual uniformity",
    "stages": [
      {
        "phase": "BUILD",
        "shot": "GLOBAL",
        "field": "large_pitch_context",
        "purpose": "locate first build-up relation and attack direction"
      },
      {
        "phase": "STRETCH",
        "shot": "SEMI_GLOBAL",
        "field": "middle_thirds",
        "purpose": "show midfield width and defensive block stretch"
      },
      {
        "phase": "BETWEEN_LINES",
        "shot": "RELATION_CLOSE",
        "field": "central_attacking_zone",
        "purpose": "show receiver between lines without losing reference structure"
      },
      {
        "phase": "OVERLAP",
        "shot": "RELATION_CLOSE",
        "field": "right_half_space_and_flank",
        "purpose": "show carrier-overlap-defender timing"
      },
      {
        "phase": "SHIFT_AND_SWITCH",
        "shot": "SEMI_GLOBAL",
        "field": "both_sides_of_attacking_half",
        "purpose": "show strong-side attraction and weak-side release"
      },
      {
        "phase": "COMPLETE",
        "shot": "RESULT_MEDIUM",
        "field": "final_third_and_box",
        "purpose": "show weak-side reception, depth, defenders and goal"
      }
    ],
    "rules": {
      "full_picture_does_not_mean_full_pitch_every_time": true,
      "local_closeup_may_crop_pitch_lines": true,
      "retain_attack_direction_reference": true,
      "return_to_structure_after_local_relation": true,
      "pitch_extent_must_match_tactical_question": true,
      "minimum_necessary_field_extent": true
    },
    "version": "V10.1"
  },
  "central_master": {
    "benchmark": "TEACTICS",
    "principle": "use a stable floating pitch-centred master shot as the spatial map; the whole physical pitch board must remain visible with dark breathing room around it",
    "field_scope": "FLOATING_BOARD",
    "tilt_back_m": 4.8,
    "uses": [
      "OPENING_MAP",
      "STRONG_WEAK_SIDE_RESET"
    ],
    "rules": [
      "pitch board centre owns composition in CENTRAL_MASTER",
      "show the full physical board silhouette, not only the white touchlines",
      "preserve dark breathing room around the board so it reads as suspended in space",
      "do not let player clusters drag the master shot off-centre",
      "use the floating master briefly as spatial orientation, then return to tactical relation framing"
    ]
  },
  "camera_anticipation": {
    "enabled": true,
    "principle": "camera prepares the next tactical relationship before the action arrives; no camera move is timed to narration",
    "target_lead_sec": {
      "relation": 0.6,
      "overlap": 0.75,
      "global_reset": 0.75,
      "weak_side_receive": 0.8
    }
  }
}
