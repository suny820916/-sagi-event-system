  "preview_mode": true,
  "director_mode": "TACTICAL_EXECUTION",
  "principles": [
    "complete_pattern_over_dramatic_pacing",
    "tactical_cause_before_camera_motion",
    "defensive_reaction_must_be_visible",
    "no_climax_treatment",
    "hold_final_shape_until_execution_is_readable"
  ],
  "execution_phases": [
    {
      "name": "BUILD",
      "from": 0,
      "to": 2.1,
      "question": "How does Pirlo receive under first pressure?"
    },
    {
      "name": "STRETCH",
      "from": 2.1,
