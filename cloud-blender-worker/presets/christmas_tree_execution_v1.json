      "question": "How is the weak-side advantage fully executed?"
    }
  ],
  "initial_ball_holder": "LCB",
  "require_defensive_reaction": true,
  "benchmark": {
    "reference": "TEACTICS",
    "principle": "learn_expression_not_copy_content",
    "locked_direction": true,
    "priorities": [
      "visible_pitch_scope_must_match_tactical_information",
      "full_pitch_and_local_pitch_are_both_valid_when_tactically_motivated",
      "weak_side_space_must_be_caused_by_collective_defensive_shift",
      "defenders_should_move_as_a_block_not_as_isolated_markers",
      "receive_turn_next_action_must_read_as_one_chain",
      "body_orientation_should_reveal_tactical_intent",
      "no_floating_pitch_or_black_void_in_wide_structure_views",
      "no_abrupt_scale_reset_between_tactical_phases",
      "camera_center_must_follow_tactical_progression",
      "no_tactical_subject_on_frame_edge",
      "whole_tactical_picture_before_local_beauty",
      "local_relation_must_keep_formation_context",
      "spatial_continuity_between_phases",
      "relation_camera_must_protect_start_mid_end_positions",
      "switch_camera_may_follow_ball_between_zones",
      "players_must_read_as_people_not_chess_pieces",
      "tactical_clarity",
      "complete_execution",
      "stable_camera_until_relation_changes",
      "ball_drives_tempo",
      "player_reaction_follows_tactical_cause",
      "no_unnecessary_effects",
      "no_dramatic_climax",
      "minimal_dead_time",
      "few_relevant_players_per_frame"
    ]
  },
  "visual_integrity": {
    "locked": true,
    "rule": "Every tactical shot must preserve both the local relation and enough formation structure to understand where it belongs.",
    "minimum_context": "carrier + next option + nearest defender + two structural anchors",
    "no_isolated_triangle_shots": true,
    "no_contextless_closeups": true,
    "preserve_attack_direction": true,
    "preserve_spatial_continuity": true,
    "edge_safe_zone": true,
    "edge_safe_rule": "No tactical subject should sit on or be clipped by the portrait-frame edge.",
    "spatial_continuity": true,
    "scale_continuity": true,
    "continuous_tactical_background": true,
    "background_rule": "Wide tactical views may reveal more board, but must never reveal a hard visual void beyond the pitch.",
    "field_scope_is_tactical": true,
    "field_scope_rule": "The amount of pitch visible must be chosen by tactical information need, not by a fixed camera aesthetic."
  },
  "camera_continuity": {
    "preserve_forward_progression": true,
    "max_backward_target_m": 1.5,
    "lead_sec": 0.34,
    "settle_sec": 0.32,
    "principle": "preserve spatial continuity, but allow deliberate tactical scale changes between structure and relation shots",
    "preserve_scale_continuity": true,
    "max_zoom_in_per_phase_m": 8,
    "allow_scale_reset_on_shot_scale_change": true
  },
  "action_continuity": {
    "enabled": true,
    "principle": "the next tactical action begins in body orientation before the current action fully ends",
    "passer_pre_turn_sec": 0.12,
    "receiver_scan_sec": 0.18,
    "post_receive_turn_window_sec": 0.34,
    "first_touch_distance_m": 0.16
  },
  "defensive_response": {
    "enabled": true,
    "principle": "space must be created by visible collective defensive movement, not by static empty zones",
    "strong_side_shift": "right",
    "weak_side_release": "left"
  },
  "scale_script": {
    "principle": "camera scale and visible pitch area are both tactical language",
    "benchmark": "TEACTICS",
    "rules": [
      "use full or near-full pitch only when the viewer needs global structure",
      "use half-pitch or zone framing when the tactical relation is local",
      "never show the whole field just to look complete",
      "never crop pitch landmarks that are needed to understand the action",
      "return to wider pitch context after a local tactical explanation when the next phase depends on global spacing",
      "global-to-local and local-to-global scale changes may be decisive when the tactical question changes"
    ],
    "phases": {
      "BUILD": {
        "shot_scale": "STRUCTURE",
        "field_scope": "DEFENSIVE_HALF_PLUS_MIDFIELD",
        "purpose": "show buildup base, Pirlo depth and first pressure"
      },
      "STRETCH": {
        "shot_scale": "WIDE_STRUCTURE",
        "field_scope": "CENTRAL_THREE_QUARTERS",
        "purpose": "show both side midfielders stretching the block"
      },
      "BETWEEN_LINES": {
        "shot_scale": "RELATION",
        "field_scope": "MIDFIELD_ZONE",
        "purpose": "show Pirlo-Kaka-defender relation without wasting screen on remote pitch"
      },
      "OVERLAP": {
        "shot_scale": "RELATION",
        "field_scope": "RIGHT_CHANNEL_ZONE",
        "purpose": "show Kaka-RB-defender triangle and overlap timing"
      },
      "SHIFT_AND_SWITCH": {
        "shot_scale": "WIDE_STRUCTURE",
        "field_scope": "ATTACKING_TWO_THIRDS",
        "purpose": "show strong-side defensive shift and weak-side space simultaneously"
      },
      "COMPLETE": {
        "shot_scale": "RESULT_RELATION",
        "field_scope": "FINAL_THIRD",
        "purpose": "show weak-side receive, central occupation, defenders and goal relation"
      }
    },
    "local_relation_history_sec": 0.68
  }
